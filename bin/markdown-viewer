#!/usr/bin/env bash
# ==============================================================================
# markdown-viewer CLI launcher
# Opens markdown files, directories, or piped input in Markdown Viewer.app
# ==============================================================================

set -e

VERSION="1.4.0"

# Auto-close transient Terminal window if launched via LaunchServices ('open bin/markdown-viewer')
cleanup_transient_terminal() {
  if [ -n "${TERM_PROGRAM}" ] && [ "${TERM_PROGRAM}" = "Apple_Terminal" ]; then
    PARENT_CMD="$(ps -o comm= -p $PPID 2>/dev/null || true)"
    if [[ "${PARENT_CMD}" == *"login"* ]]; then
      (sleep 0.5 && osascript -e 'tell application "Terminal" to close (every window whose name contains "markdown-viewer")' &>/dev/null) &
    fi
  fi
}
trap cleanup_transient_terminal EXIT

show_help() {
  cat << EOF
Markdown Viewer CLI (v${VERSION})
Usage: markdown-viewer [OPTIONS] [FILE ...]

Options:
  -h, --help       Show this help message and exit
  -v, --version    Show version information and exit

Examples:
  markdown-viewer                        # Open Markdown Viewer
  markdown-viewer README.md              # Open a markdown file
  markdown-viewer doc1.md doc2.md        # Open multiple files in tabs
  cat error.log | markdown-viewer        # Pipe terminal output into viewer

Notes:
  Run 'markdown-viewer' directly in your terminal.
  Do not prefix with 'open' (which triggers macOS to open a separate Terminal session).
EOF
}

# Handle flag options
case "${1:-}" in
  -h|--help)
    show_help
    exit 0
    ;;
  -v|--version)
    echo "Markdown Viewer v${VERSION}"
    exit 0
    ;;
esac

# Locate Markdown Viewer.app
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_PATH=""

if [ -d "/Applications/Markdown Viewer.app" ]; then
  APP_PATH="/Applications/Markdown Viewer.app"
elif [ -d "${HOME}/Applications/Markdown Viewer.app" ]; then
  APP_PATH="${HOME}/Applications/Markdown Viewer.app"
elif [ -d "${SCRIPT_DIR}/../build/Markdown Viewer.app" ]; then
  APP_PATH="$(cd "${SCRIPT_DIR}/../build/Markdown Viewer.app" && pwd)"
elif [ -d "${SCRIPT_DIR}/../Markdown Viewer.app" ]; then
  APP_PATH="$(cd "${SCRIPT_DIR}/../Markdown Viewer.app" && pwd)"
elif [ -d "${SCRIPT_DIR}/../../Markdown Viewer.app" ]; then
  APP_PATH="$(cd "${SCRIPT_DIR}/../../Markdown Viewer.app" && pwd)"
fi

OPEN_CMD="open"
if [ -n "${APP_PATH}" ]; then
  OPEN_TARGET=("-a" "${APP_PATH}")
else
  OPEN_TARGET=("-a" "Markdown Viewer")
fi

# Case 1: Piped input from stdin (e.g. 'cat README.md | markdown-viewer')
if [ ! -t 0 ]; then
  TMP_FILE="$(mktemp -t markdown-viewer-piped.XXXXXX).md"
  cat > "${TMP_FILE}"
  "${OPEN_CMD}" "${OPEN_TARGET[@]}" "${TMP_FILE}"
  exit 0
fi

# Case 2: No file arguments passed -> Just launch / focus app
if [ $# -eq 0 ]; then
  "${OPEN_CMD}" "${OPEN_TARGET[@]}"
  exit 0
fi

# Case 3: One or more files passed -> Resolve absolute paths
RESOLVED_FILES=()
for arg in "$@"; do
  if [ -f "${arg}" ]; then
    # Convert relative path to absolute
    ABS_PATH="$(cd "$(dirname "${arg}")" && pwd)/$(basename "${arg}")"
    RESOLVED_FILES+=("${ABS_PATH}")
  elif [ -e "${arg}" ]; then
    RESOLVED_FILES+=("$(cd "$(dirname "${arg}")" && pwd)/$(basename "${arg}")")
  else
    echo "Warning: File not found: ${arg}" >&2
  fi
done

if [ ${#RESOLVED_FILES[@]} -gt 0 ]; then
  "${OPEN_CMD}" "${OPEN_TARGET[@]}" "${RESOLVED_FILES[@]}"
else
  echo "Error: No valid files specified." >&2
  exit 1
fi
